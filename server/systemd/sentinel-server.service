# The server on a Linux machine (the Pi 5 stand-in now, a cloud server later): docs/server-on-linux.md.
# The paths are for the repo cloned to /home/pi/applev2 by user pi: edit them for another machine.
[Unit]
Description=Orchard Sentinel server (API, dashboard, detection and classification)
Wants=network-online.target
After=network-online.target

[Service]
User=pi
# .env (detector, classifier, dashboard password) is read from here.
WorkingDirectory=/home/pi/applev2/server
ExecStart=/home/pi/applev2/server/.venv/bin/sentinel-server serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
