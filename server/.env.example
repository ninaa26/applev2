# Copy to .env in the folder you run `sentinel-server` from.
SENTINEL_DATA_DIR=data                  # database + photos; copy this folder to move servers
# SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:pw@localhost/sentinel   # real server later
SENTINEL_TZ=America/New_York
SENTINEL_DETECTOR=baseline              # baseline | flatbug
SENTINEL_CLASSIFIER=none                # none | bioclip (v0 zero-shot) | bioclip-v1 | cnn-v2
# SENTINEL_CLASSIFIER_HEAD=../ml/models/v1/head.npz   # for bioclip-v1: written by ml/train_v1.py
# SENTINEL_CLASSIFIER_MODEL=../ml/models/v2/efficientnet_b0.pt   # for cnn-v2: written by ml/train_v2.py
SENTINEL_GRID_MM=25.4                   # liner grid spacing (measure yours); sets the image scale
SENTINEL_OFFLINE_AFTER_H=12
