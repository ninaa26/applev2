{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "field-labeler",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd ml && exec .venv/bin/python label_field_cards.py --port 8765"
      ],
      "port": 8765
    },
    {
      "name": "ofm-labeler",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd ml && exec .venv/bin/python label_field_cards.py --data data/web_liners/label/ofm-ervins --port 8766"
      ],
      "port": 8766
    },
    {
      "name": "model-playground",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd ml && exec .venv/bin/python model_playground.py --port 8770"
      ],
      "port": 8770
    },
    {
      "name": "server-dashboard",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd server && SENTINEL_DATA_DIR=data/dev SENTINEL_CLASSIFIER=none exec .venv/bin/sentinel-server serve --host 127.0.0.1 --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "schematics",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd design/schematics && exec python3 -m http.server 8790 --bind 127.0.0.1"
      ],
      "port": 8790
    }
  ]
}
