[Unit]
Description=Orchard Sentinel wake cycle (photograph liner, upload, schedule next wake, power off)
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service time-sync.target

[Service]
Type=oneshot
User=sentinel
# Give Wi-Fi/Tailscale a moment; the cycle still works offline (photos stay queued).
ExecStartPre=/bin/sleep 15
ExecStart=/opt/sentinel/venv/bin/sentinel-cycle --config /etc/sentinel/config.toml
# Backstop for a hung cycle. A killed cycle sets no wake alarm and doesn't power off, so the cycle
# stops starting uploads after UPLOAD_BUDGET_S (cycle.py) to finish well inside this.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
