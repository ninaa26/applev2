# Settings for the ESP32 window day test. The scripts in this folder source this file.
HUB=pi@apple-pi-hub                       # the hub Pi (gateway only), over Tailscale
SERVER=pi@apple-pi-server                 # the server Pi
TRAP=T2                                   # the ESP32 camera under test
HUB_TRAP=T1                               # the hub's id on the server
HUB_DIR=/home/pi/sentinel-hub             # where the hub's gateway runs from (bench hub layout)
HUB_CONFIG=/home/pi/sentinel-hub/hub.toml
HUB_DATA=/home/pi/sentinel-hub/data       # data_dir in the hub config: nodes/<trap>/{queue,sent,status.jsonl}
SERVER_DIR=/home/pi/applev2/server        # .venv, .env and data/ of the server
PHOTO_EVERY_MIN=30                        # the test schedule: a photo every 30 min, all day
CHECKIN_MIN=10                            # check-ins between photos, for Take a photo now
ESP32_PORT=                               # e.g. /dev/cu.usbmodem5B414842831 if the ESP32 runs off this laptop's USB
